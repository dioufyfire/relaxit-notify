APP_NAME="RelaxIT Notify"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# HTTPS en production ; conserver false uniquement pour le développement HTTP local.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
TRUSTED_PROXIES=

# Pilote Meta : aucun envoi tant que désactivé. Secrets à renseigner sur le serveur.
META_WHATSAPP_ENABLED=false
META_WHATSAPP_MODE=pilot
META_WHATSAPP_APPLICATION=dolibarr
META_WHATSAPP_MAX_ATTEMPTS_PER_24H=250
META_WHATSAPP_VERSION=v25.0
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_TENANT_CODE=GLOBALE_SANTE
META_WHATSAPP_TEST_RECIPIENT=
META_WHATSAPP_ENABLED_AFTER=
META_WHATSAPP_TEMPLATE=
# Modèles supplémentaires approuvés : même langue, image et variables que le modèle principal.
META_WHATSAPP_ADDITIONAL_TEMPLATES=
META_WHATSAPP_LANGUAGE=en_US
META_WHATSAPP_HEADER_IMAGE_URL=
META_WHATSAPP_BODY_VARIABLES=

# Réception des statuts Meta, indépendante de l’activation des envois.
META_WHATSAPP_WEBHOOK_ENABLED=false
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_WABA_ID=
